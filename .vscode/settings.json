  "cmake.cmakePath": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.4.0+st.1/bin/cmake.exe",
  "cmake.useCMakePresets": "always",
  "cmake.configureOnOpen": false,
  "files.exclude": {
    "build": true,
    ".cache": true
  },
  "search.exclude": {
    "Drivers": true
