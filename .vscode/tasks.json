{
  "version": "2.0.0",
  "tasks": [
    {
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "label": "Configure firmware",
      "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.4.0+st.1/bin/cmake.exe",
      "args": [
        "--preset",
        "debug"
      ],
      "problemMatcher": [
        "$gcc"
      ],
      "hide": true
    },
    {
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "label": "Build firmware",
      "command": "${env:LOCALAPPDATA}/stm32cube/bundles/cmake/4.4.0+st.1/bin/cmake.exe",
      "args": [
        "--build",
        "--preset",
        "debug"
      ],
      "dependsOn": "Configure firmware",
      "problemMatcher": [
        "$gcc"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      }
    },
    {
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "label": "Flash and run (ST-LINK)",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/board.ps1",
        "Flash"
      ],
      "dependsOn": "Build firmware",
      "problemMatcher": []
    },
    {
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "label": "Flash and verify UART printf",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/board.ps1",
        "Verify"
      ],
      "dependsOn": "Build firmware",
      "problemMatcher": []
    },
    {
      "type": "process",
      "options": {
        "cwd": "${workspaceFolder}"
      },
      "label": "Monitor FTDI UART (115200, 8N1)",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/tools/board.ps1",
        "Monitor"
      ],
      "problemMatcher": []
    }
  ]
}

